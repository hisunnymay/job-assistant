{
  "name": "ai-job-fit-assistant-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
